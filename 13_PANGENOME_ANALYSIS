# STAGE 12: PANGENOME CONSTRUCTION WITH PYAMILYSEQ

# Purpose:
   Construct a core gene alignment and gene presence–absence matrix using PyamilySeq in amino‑acid mode. 
This stage clusters CDS sequences,identifies core and accessory genes, and generates alignment files for
downstream analysis.

# Inputs:
   - *.final.gff files generated by ORForise
   - Corresponding *.fna genome files
   - PyamilySeq v1.3.4 installed on Kelvin2
   - Compute node with ≥150 GB RAM and ≥20 CPU cores

# Outputs:
#   - pyamilyseq_output/ directory containing:
#       - Core gene alignment (FASTA)
#       - Gene presence–absence CSV
#       - Cluster group files (99% and 95% identity)
#       - Individual cluster FASTA files
#       - Summary logs and reports

# Notes:
#   - AA mode reduces noise from minor nucleotide variation.
#   - Identity threshold = 0.90; length difference threshold = 0.80.
#   - Core genes defined as those present in ≥99% of genomes.
#   - Ensure .final.gff and .fna filenames match genome IDs.

## SCRIPT
#!/bin/bash                                      
#SBATCH --time=3-23:59:00                        # Max runtime (3 days, 23h, 59m)
#SBATCH --partition=k2-lowpri,k2-bioinf          # Queues
#SBATCH --mem=150G                               # Total memory requested
#SBATCH --cpus-per-task=20                       # Number of CPU
#SBATCH --job-name=PAN                           # Job name
#SBATCH --output=PY-%j.out                       # output log
#SBATCH --error=PY-%j.err                        # Error log
#SBATCH --mail-user=kmagill102@qub.ac.uk         # Email notifications
#SBATCH --mail-type=BEGIN,END,FAIL               # When to send emails

mkdir -p pyamilyseq_output                       # Create output directory if missing

PyamilySeq Full \                                # Run PyamilySeq in full mode
  -output_dir ./pyamilyseq_output \              # Directory for all results
  -input_type separate \                         # GFF and FASTA provided separately
  -input_dir . \                                 # Use current directory as input
  -name_split_gff .final.gff \                   # Identify GFF files by suffix
  -name_split_fasta .fna \                       # Identify FASTA files by suffix
  -sequence_type AA \                            # Use amino acid sequences
  -gene_ident CDS \                              # Extract CDS features
  -c 0.90 \                                      # Identity threshold for clustering
  -s 0.80 \                                      # Length difference threshold
  -write_groups 99,95 \                          # Write cluster groups at 99% & 95%
  -write_individual_groups \                     # Output FASTA for each cluster
  -align \                                       # Produce core gene alignment
  -M 180000 \                                    # Max memory for CD-HIT (in MB)
  -T 20                                          # Number of threads

# QUALITY CHECKS (run manually after job completes)
#   - Confirm number of genomes processed matches expected input
#   - Inspect core alignment length and cluster counts
#   - Review PyamilySeq logs for warnings or skipped genomes

# END OF STAGE 12

