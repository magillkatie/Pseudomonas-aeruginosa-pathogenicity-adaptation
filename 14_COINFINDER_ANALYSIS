# STAGE 13: ASSOCIATION ANALYSIS WITH COINfinder

# Overview:
   Stage 13 identifies statistically significant gene associations and disassociations across the pangenome. 
   This requires three sub‑stages:
   
   13.a – Build a maximum‑likelihood phylogenetic tree from the PyamilySeq core gene alignment  
   13.b – Correct zero‑length branches to avoid division‑by‑zero errors in COINfinder  
   13.c – Run COINfinder using the corrected tree and gene presence/absence matrix  
#STAGE 13.a
# Purpose:
    Convert the PyamilySeq core gene alignment into a Newick-format phylogenetic tree using FastTree.
    This tree is required as input for COINfinder.

# Inputs:
   - core_gene_alignment.aln (from PyamilySeq)
   - FastTree v2.1.11 installed on Kelvin2

# Outputs:
   - core_gene_alignment.newick

# Notes:
   - Output is redirected into a .newick file

## SCRIPT
#!/bin/bash                                      
#SBATCH --partition=k2-lowpri,k2-bioinf          # Queues to submit job to
#SBATCH --mem=80G                                # Memory allocation
#SBATCH --job-name=fasttree                      # Job name
#SBATCH --output=TREE-%j.out                     # output log
#SBATCH --error=TREE-%j.err                      # Error log
#SBATCH --mail-user=kmagill102@qub.ac.uk         # Email notifications
#SBATCH --mail-type=BEGIN,END,FAIL               # When to send emails

fasttree -nt core_gene_alignment.aln \           # Build Max likelihood tree from  alignment
    > core_gene_alignment.newick                 # Save output in Newick format

# END OF STAGE 13.a
#STAGE 13.b
# Purpose:
   Remove zero-length branches from the FastTree output to prevent division-by-zero errors in COINfinder.

# Inputs:
   - core_gene_alignment.newick (FastTree output)

# Outputs:
   - tree_1e-06.nwk (corrected tree with small branch lengths added)

# Notes:
   - COINfinder cannot process zero-length branches
   - A tiny constant (1e-6) is added to all branch lengths

## SCRIPT (RUN LOCALLY IN R)
install.packages("ape")                         # Install APE
library(ape)                                     # Load APE library

tree <- read.tree("core_gene_alignment.newick")  # Read FastTree Newick file

tree[["edge.length"]] <-                         # Access branch lengths
    tree[["edge.length"]] + 1e-6                 # Add tiny constant to avoid zeros

write.tree(tree, file="tree_1e-06.nwk")          # Write corrected tree to file

# END OF STAGE 13.b
#STAGE 13.c
# Purpose:
   Identify statistically significant gene–gene associations and exclusions
   using COINfinder. This analysis uses the corrected phylogenetic tree and
   the PyamilySeq presence/absence matrix.

# Inputs:
   - cleaned_coin.csv (gene presence/absence matrix)
   - tree_1e-06.nwk (corrected phylogenetic tree)
   - COINfinder v1.2.1 installed on Kelvin2

# Outputs:
   - Coinfinder_associated/ directory containing:
       - Associated gene pairs
       - Excluded gene pairs
       - Network files
       - Summary statistics

# Notes:
   - Default COINfinder settings used
   - -I flag treats input as presence/absence matrix
   - -p supplies the phylogenetic tree
   - -x sets number of threads

## SCRIPT
#!/bin/bash                                      
#SBATCH --job-name=COIN_A                        # Job name
#SBATCH --output=COINA-%j.out                    # output log
#SBATCH --error=COINA-%j.err                     # Error log
#SBATCH --time=10-23:59:00                       # Max runtime
#SBATCH --partition=k2-lowpri,k2-bioinf          # Queues to submit job to
#SBATCH --cpus-per-task=8                        # Number of CPU threads
#SBATCH --mem=150G                               # Memory allocation
#SBATCH --mail-user=kmagill102@qub.ac.uk         # Email notifications
#SBATCH --mail-type=BEGIN,END,FAIL               # When to send emails

coinfinder \
  -i cleaned_coin.csv \                          # Input presence/absence matrix
  -I \                                            # Indicates matrix format
  -p tree_1e-06.nwk \                             # Corrected phylogenetic tree
  -o Coinfinder_associated \                      # Output directory prefix
  --associate \                                   # Run association analysis
  -x 8                                            # Number of threads

# END OF STAGE 13.c


