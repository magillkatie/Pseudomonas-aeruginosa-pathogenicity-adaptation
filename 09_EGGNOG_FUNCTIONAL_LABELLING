# STAGE 8: FUNCTIONAL ANNOTATION WITH eggNOG-MAPPER

# Purpose:
#   Assign functional annotations to all predicted proteins from the Pseudomonas genomes using eggNOG-mapper. 
#   Each genome's protein FASTA (.faa) file (produced by Bakta in Stage 2) is searched against the eggNOG database using DIAMOND.
#   This produces orthology assignments, KEGG pathway mappings, GO terms, COG categories, and other functional metadata for each predicted protein.

# Inputs:
#   - *.faa protein FASTA files generated by Bakta in Stage 2
#   - eggNOG-mapper v2.1.6 installed in conda environment
#   - eggNOG database located at:
#       /mnt/scratch2/igfs-anaconda/conda-envs/eggnog/lib/python3.9/site-packages/data

# Outputs:
#   - EGGnog_results/ directory containing per-genome output files:
#       - <genome_id>.emapper.annotations       (main annotation table — tab-separated)
#       - <genome_id>.emapper.hits               (raw DIAMOND hits)
#       - <genome_id>.emapper.seed_orthologs     (best seed ortholog per query protein)
#   The annotations file contains the following key columns:
#       - query                  (protein ID from .faa input)
#       - seed_ortholog          (best matching eggNOG ortholog)
#       - evalue / score         (alignment statistics)
#       - eggNOG_OGs             (orthologous group assignments at multiple taxonomic levels)
#       - max_annot_lvl          (deepest taxonomic level with annotation)
#       - COG_category           (Clusters of Orthologous Genes functional category)
#       - Description            (functional description of best ortholog)
#       - Preferred_name         (gene name if available)
#       - GOs                    (Gene Ontology terms)
#       - EC                     (Enzyme Commission number)
#       - KEGG_ko                (KEGG orthology identifiers)
#       - KEGG_Pathway           (KEGG pathway mappings)
#       - KEGG_Module            (KEGG module mappings)
#       - KEGG_Reaction          (KEGG reaction identifiers)
#       - KEGG_rclass            (KEGG reaction class)
#       - BRITE                  (KEGG BRITE hierarchy)
#       - KEGG_TC                (transporter classification)
#       - CAZy                   (carbohydrate-active enzyme families)
#       - BiGG_Reaction          (BiGG metabolic reaction identifiers)
#       - PFAMs                  (Pfam domain identifiers)

# Notes:
#   - eggNOG-mapper uses DIAMOND (-m diamond) for the initial homology search step.
#   - --dbmem flag loads the entire eggNOG DIAMOND database into memory, significantly speeding up searches at the cost of higher RAM usage; 50G was allocated to accommodate this.
#   - --dmnd_iterate no disables iterative DIAMOND search; a single-pass search is sufficient for well-annotated species such as Pseudomonas.
#   - DIAMOND v0.9 is loaded as a module rather than from the conda environment, ensure version compatibility with eggNOG-mapper v2.1.6 if re-running.
#   - Input files are .faa (protein) rather than .fna (nucleotide); eggNOG-mapper operates on protein sequences.
#   - Array range set to 1-59 reflecting the number of .faa files available after Stage 2 annotation. 
#   - 24 CPUs are allocated per task (higher than AMRFinderPlus) due to the computational demands of DIAMOND database search.
#   - Output files are named by genome basename (stripped of .faa extension).
#   - COG category assignments are particularly useful for functional comparisons across genomes and can be aggregated for pan-genome functional profiling.

# Software versions:
#   - eggNOG-mapper v2.1.6
#   - DIAMOND v0.9 (loaded via module)

## SCRIPT

#!/bin/bash
#SBATCH --job-name=eggNOG                       # Job name visible in SLURM queue
#SBATCH --partition=k2-lowpri                   # Queue/partition to run on
#SBATCH --time=7-23:59:59                       # Maximum runtime (7 days)
#SBATCH --cpus-per-task=24                      # CPU threads per task (high; DIAMOND search is CPU-intensive)
#SBATCH --mem=50G                               # Total memory
#SBATCH --array=1-59%100                        # 59 array jobs, max 100 running simultaneously
#SBATCH --output=EGG_in-%A-%a.out               # Standard output log per array task
#SBATCH --error=EGG_in-%A-%a.err                # Error log per array task
#SBATCH --mail-user=kmagill102@qub.ac.uk        # Email notifications
#SBATCH --mail-type=BEGIN,END,FAIL              # Email on job start, end, and failure

module add diamond/0.9                          # Load DIAMOND module.

# Define directories and parameters
FAA_DIR="."                                     # Directory containing .faa protein FASTA files
OUTDIR="EGGnog_results"                         # Output directory for eggNOG-mapper results
THREADS=24                                      # Number of CPU threads passed to emapper.py
BATCH_SIZE=100                                  # Number of genomes processed per array task

mkdir -p "$OUTDIR"                              # Create output directory if it does not already exist

# Load all .faa files into a sorted array
mapfile -t FAA_FILES < <(ls "$FAA_DIR"/*.faa)

# Determine which genomes this array task should process
START=$(( (SLURM_ARRAY_TASK_ID - 1) * BATCH_SIZE ))
END=$(( START + BATCH_SIZE ))

# Loop through assigned genomes in this batch
for (( i=START; i<END && i<${#FAA_FILES[@]}; i++ )); do
    FAA="${FAA_FILES[$i]}"

    echo "Annotating: $FAA"                     # Progress message for output log

    emapper.py \
        --data_dir /mnt/scratch2/igfs-anaconda/conda-envs/eggnog/lib/python3.9/site-packages/data \
                                                # Path to eggNOG database directory
        -i "$FAA" \                             # Input protein FASTA file
        -o "$OUTDIR/$(basename "${FAA%.faa}")" \ # Output prefix named by genome ID
        -m diamond \                            # Use DIAMOND
        --cpu "$THREADS" \                      # Number of threads
        --dbmem \                               # Load database into memory for faster searching
        --dmnd_iterate no                       # Disable iterative DIAMOND search
done

# QUALITY CHECKS (run manually after job completes)
#   Count number of annotation files produced:
#       ls -1 EGGnog_results/*.emapper.annotations | wc -l
#       (should equal number of input .faa files)
#
#   Inspect error logs for failed samples:
#       grep -i "error" EGG_in-*.err

# END OF STAGE 8
