  geom_col(position = position_dodge(width = 0.7), width = 0.7, color = "black") +
  geom_text(
    aes(label = Signif),
    position = position_dodge(width = 0.7),
    hjust    = -0.3,
    size     = 5,
    fontface = "bold"
  ) +
  scale_fill_manual(values = c("Core copy" = "#2196F3", "Accessory amrZ" = "#F44336")) +
  scale_x_continuous(limits = c(0, max(gene_prev_top$Prevalence) + 5), expand = c(0, 0)) +
  theme_classic(base_size = 13) +
  labs(
    title    = "Top 20 Acquired AMR Genes Differing Between amrZ Groups",
    subtitle = "Bars show prevalence; stars indicate FDR significance",
    x        = "% isolates with gene present",
    y        = "Acquired AMR Gene",
    fill     = "amrZ Variant"
  )
 
