  group_by(amrZ_group) %>%
  summarise(Proportion = mean(Acquired_AMR > 0) * 100)
 
p2 <- ggplot(prop_df, aes(x = amrZ_group, y = Proportion, fill = amrZ_group)) +
  geom_col(color = "black") +
  geom_text(aes(label = paste0(round(Proportion, 1), "%")), vjust = -0.5, size = 4) +
  scale_fill_manual(values = c("Core copy" = "#2196F3", "Accessory amrZ" = "#F44336")) +
  scale_y_continuous(limits = c(0, 55), expand = c(0, 0)) +
  theme_classic(base_size = 13) +
  theme(legend.position = "none") +
  labs(title = "Proportion of Isolates with Acquired AMR Genes", x = NULL, y = "% with Acquired AMR")
 
### 16. Plot C — Horizontal bar chart: top 20 genes with FDR stars
