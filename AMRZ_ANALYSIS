### 13. Apply human-readable gene labels and set factor order
gene_prev_top$Gene_label <- ifelse(
  as.character(gene_prev_top$Gene) %in% names(gene_name_map),
  gene_name_map[as.character(gene_prev_top$Gene)],
  as.character(gene_prev_top$Gene)
)
 
gene_order_labels <- ifelse(
  gene_diff$Gene %in% names(gene_name_map),
  gene_name_map[gene_diff$Gene],
  gene_diff$Gene
)
 
# Merge FDR values and assign significance stars
gene_prev_top <- gene_prev_top %>%
  left_join(gene_stats[, c("Gene", "FDR")], by = "Gene")
 
gene_prev_top$Signif <- cut(
  gene_prev_top$FDR,
  breaks = c(-Inf, 0.001, 0.01, 0.05, Inf),
  labels = c("***", "**", "*", "")
)
 
# Apply ordered factor levels (largest difference at top)
gene_prev_top$Gene_label <- factor(gene_prev_top$Gene_label,
                                   levels = rev(gene_order_labels))
 
### 14. Plot A — Boxplot: acquired AMR gene count by amrZ variant
library(ggplot2)
 
p1 <- ggplot(plot_df_amrZ, aes(x = amrZ_group, y = Acquired_AMR, fill = amrZ_group)) +
  geom_boxplot(outlier.shape = NA, alpha = 0.7) +
  geom_jitter(aes(color = amrZ_group), width = 0.2, alpha = 0.4, size = 1) +
  scale_fill_manual(values  = c("Core copy" = "#2196F3", "Accessory amrZ" = "#F44336")) +
  scale_color_manual(values = c("Core copy" = "#2196F3", "Accessory amrZ" = "#F44336")) +
  theme_classic(base_size = 13) +
  theme(legend.position = "none") +
  labs(title = "Acquired AMR Gene Count by amrZ Variant", x = NULL, y = "Acquired AMR Genes")
 
### 15. Plot B — Bar chart: proportion of isolates with ≥1 acquired AMR gene
