# amrZ ANALYSIS — ACQUIRED AMR GENE ASSOCIATIONS.
 
# Purpose:
#    Investigate whether isolates carrying an accessory (duplicate) copy of amrZ are associated with higher acquired AMR genes.
#    Includes:
#      - Group assignment (Core copy / Accessory amrZ / No amrZ detected)
#      - Wilcoxon and chi-squared tests for acquired AMR burden
#      - Per-gene Fisher's exact tests with FDR correction
#      - Visualisations: boxplot, proportion bar chart, top-20 gene prevalence panel
 
# Inputs:
#    - Roary presence/absence matrix (gene_presence_absence_annotated.csv)
#    - Columns 15 → (GENE_TYPE - 1) represent isolates
#    - AMR genes annotated with suffix "_amr"
#    - Biofilm/amrZ genes annotated in eggNOG as "amrZ(biofilm)"
#    - core_5_names vector (defined in AST blind-spot script)
 
# Outputs:
#    - scores_df: per-isolate table with amrZ group and acquired AMR count
#    - summary_by_amrZ: group-level summary statistics
#    - significant_genes: acquired AMR genes significantly associated with amrZ group
#    - Plots:
#        A. Boxplot of acquired AMR gene count by amrZ variant
#        B. Proportion of isolates with ≥1 acquired AMR gene
#        C. Top 20 acquired AMR genes differing between groups (with FDR stars)
#        D. Combined panel (patchwork)
 
# Notes:
#    - amrZ families are identified via eggNOG annotation: "amrZ(biofilm)"
#    - The most prevalent amrZ pangenome family = canonical (core copy)
#    - The second most prevalent = accessory (duplicate) copy
#    - Acquired AMR genes exclude core_5_names
#    - FDR correction applied using Benjamini-Hochberg method
#    - Gene group IDs are mapped to names via gene_name_map
 
---
 
## SCRIPT
 
### 0. Load data
pav <- read.csv("~/Downloads/gene_presence_absence_annotated.csv",
                check.names = FALSE, stringsAsFactors = FALSE)
 
### 1. Extract isolate columns and build binary presence/absence matrix
isolate_cols     <- 15:(which(names(pav) == "GENE_TYPE") - 1)
genome_cols      <- pav[, isolate_cols]
genome_cols_only <- (genome_cols != "" & !is.na(genome_cols)) * 1
 
### 2. Identify AMR and biofilm gene rows
strict_amr_rows    <- grepl("_amr$", pav$Gene)
biofilm_rows       <- grepl("\\(biofilm\\)", pav$eggnog)
biofilm_gene_clean <- gsub(" \\(biofilm\\)", "", pav$eggnog)
 
### 3. Identify amrZ pangenome families and rank by prevalence
amrZ_rows <- biofilm_rows & biofilm_gene_clean == "amrZ"
 
amrZ_family_counts <- data.frame(
  Family = pav$Gene[amrZ_rows],
  Count  = rowSums(genome_cols_only[amrZ_rows, ] == 1)
)
 
ordered          <- amrZ_family_counts[order(amrZ_family_counts$Count, decreasing = TRUE), ]
canonical_family <- ordered$Family[1]   # most prevalent = core copy
duplicate_family <- ordered$Family[2]   # second = accessory copy
 
### 4. Identify which isolates carry each amrZ variant
canonical_row <- which(pav$Gene == canonical_family)
duplicate_row <- which(pav$Gene == duplicate_family)
 
has_canonical <- colnames(genome_cols_only)[genome_cols_only[canonical_row, ] == 1]
has_duplicate <- colnames(genome_cols_only)[genome_cols_only[duplicate_row, ] == 1]
 
### 5. Assign amrZ group to each isolate
scores_df <- data.frame(Isolate = colnames(genome_cols_only))
 
scores_df$amrZ_group <- ifelse(
  scores_df$Isolate %in% has_duplicate, "Accessory amrZ",
  ifelse(scores_df$Isolate %in% has_canonical, "Core copy",
         "No amrZ detected")
)
 
### 6. Count acquired AMR genes per isolate (excluding Core-5)
acquired_amr_rows  <- strict_amr_rows & !(pav$Gene %in% core_5_names)
acquired_counts    <- colSums(genome_cols_only[acquired_amr_rows, ] == 1)
scores_df$Acquired_AMR <- acquired_counts[scores_df$Isolate]
 
### 7. Summarise acquired AMR burden by amrZ group
library(dplyr)
 
summary_by_amrZ <- scores_df %>%
  group_by(amrZ_group) %>%
  summarise(
    N                   = n(),
    Mean_Acquired_AMR   = mean(Acquired_AMR),
    Median_Acquired_AMR = median(Acquired_AMR),
    Pct_with_acquired   = mean(Acquired_AMR > 0) * 100
  )
 
summary_by_amrZ
 
### 8. Statistical tests (Core copy vs Accessory amrZ only)
plot_df_amrZ <- scores_df %>%
  filter(amrZ_group %in% c("Core copy", "Accessory amrZ"))
 
# Wilcoxon rank-sum: AMR burden
wilcox.test(Acquired_AMR ~ amrZ_group, data = plot_df_amrZ)
 
# Chi-squared: presence/absence of any acquired AMR gene
contingency <- table(
  plot_df_amrZ$amrZ_group,
  plot_df_amrZ$Acquired_AMR > 0
)
chisq.test(contingency)
 
### 9. Build per-isolate presence/absence matrix for acquired AMR genes
acquired_gene_names <- pav$Gene[acquired_amr_rows]
 
acquired_pa <- as.data.frame(t(genome_cols_only[acquired_amr_rows, ] == 1))
colnames(acquired_pa) <- acquired_gene_names
acquired_pa$Isolate   <- rownames(acquired_pa)
 
acquired_pa <- acquired_pa %>%
  left_join(scores_df[, c("Isolate", "amrZ_group")], by = "Isolate") %>%
  filter(amrZ_group != "No amrZ detected")
 
### 10. Per-gene Fisher's exact tests with FDR correction
gene_pvals <- sapply(acquired_gene_names, function(g) {
  tab <- table(acquired_pa[[g]], acquired_pa$amrZ_group)
  if (nrow(tab) < 2 || ncol(tab) < 2) return(NA)
  fisher.test(tab)$p.value
})
 
gene_fdr <- p.adjust(gene_pvals, method = "BH")
 
gene_stats <- data.frame(
  Gene    = acquired_gene_names,
  p_value = gene_pvals,
  FDR     = gene_fdr
) %>% arrange(FDR)
 
significant_genes <- gene_stats[!is.na(gene_stats$FDR) & gene_stats$FDR < 0.05, ]
significant_genes
 
### 11. Identify top 20 genes with greatest prevalence difference between groups
library(tidyr)
 
gene_prev <- acquired_pa %>%
  group_by(amrZ_group) %>%
  summarise(across(all_of(acquired_gene_names), mean), .groups = "drop") %>%
  pivot_longer(-amrZ_group, names_to = "Gene", values_to = "Prevalence") %>%
  mutate(Prevalence = Prevalence * 100)
 
gene_diff <- gene_prev %>%
  pivot_wider(names_from = amrZ_group, values_from = Prevalence) %>%
  mutate(Diff = abs(`Accessory amrZ` - `Core copy`)) %>%
  arrange(desc(Diff)) %>%
  slice_head(n = 20)
 
top_genes     <- gene_diff$Gene
gene_prev_top <- gene_prev %>% filter(Gene %in% top_genes)
 
