
# STAGE 3: ANTIMICROBIAL RESISTANCE GENE DETECTION WITH AMRFINDERPLUS

# Purpose:
#   Screen all annotated genomes for antimicrobial resistance (AMR) genes.
#   NCBI AMRFinderPlus was used in combined mode.
#   Each genome is analysed using nucleotide sequence (.fna),protein sequence (.faa), and annotation (.gff3) inputs simultaneously to maximise sensitivity. 
#   Results are written as individual TSV files per genome into a single output directory for downstream analysis.

# Inputs:
#   - *.fna genome files (nucleotide sequences from Stage 1)
#   - *.faa protein files (generated by Bakta in Stage 2)
#   - *.gff3 annotation files (generated by Bakta in Stage 2)
#   - AMRFinderPlus v4.0.15 installed and accessible via CONDA environment
#   - AMRFinderPlus database (bundled with v4.0.15 install)

# Outputs:
#   - amrfinder_results/ directory containing:
#       - <genome_id>_amrfinder.tsv  (one file per genome)
#   Each TSV contains the following columns:
#       - Protein identifier
#       - Contig id
#       - Start / Stop / Strand
#       - Element/Gene symbol
#       - Sequence name (full gene/protein name)
#       - Scope (core / plus)
#       - Element type (AMR, VIRULENCE, STRESS, etc.)
#       - Element subtype (e.g. AMR/POINT etc.)
#       - Class (antibiotic class)
#       - Subclass
#       - Method (ALLELEP, BLASTP, EXACTP, etc.)
#       - Target length 
#       - Reference sequence length
#       - % Coverage of reference
#       - % Identity to reference
#       - Alignment length
#       - Closest reference accession
#       - Closest reference name
#       - HMM accession / HMM description

# Notes:
#   - AMRFinderPlus is run in complete mode.
#   - The -a bakta flag tells AMRFinderPlus that annotations were produced by Bakta,ensuring correct parsing of the GFF3 format.
#   - Providing all three input types (-n nucleotide, -p protein, -g annotation) enables AMRFinderPlus to use both protein searches and HMM-based nucleotide searches, maximising sensitivity.
#   - SLURM array indexing is used to parallelise across genomes (same strategy as
#     Stage 2); each array task processes a batch of up to 100 genomes.
#   - Array range set to 1-58 reflecting the number of annotated genomes available
#     after Stage 2.
#   - --cpus-per-task=4 is used here (rather than --ntasks=16 in Stage 2) as
#     AMRFinderPlus is less memory/CPU intensive than Bakta.
#   - Output TSV files are named by genome basename to allow straightforward merging
#     and traceability in downstream steps.
#   - If a genome is missing its corresponding .faa or .gff3 file, AMRFinderPlus
#     will error for that sample; check .err logs if output files are absent.
#   - Runtime is substantially faster than Bakta; most genomes complete in minutes.
#   - AMRFinderPlus database version should be recorded alongside software version
#     for reproducibility — check with: amrfinder --version and amrfinder --database_version

# Software version:
#   - AMRFinderPlus v4.0.15

## SCRIPT

#!/bin/bash
#SBATCH --time=7-23:59:59                    # Maximum runtime (7 days)
#SBATCH --partition=k2-lowpri,k2-bioinf      # Queue/partition to run on (two queues for flexibility)
#SBATCH --mail-user=kmagill102@qub.ac.uk     # Email notifications
#SBATCH --mem=60G                            # Total memory for the job
#SBATCH --cpus-per-task=4                    # CPU threads per task (lower than Bakta; AMRFinder is less intensive)
#SBATCH --nodes=1                            # Run on a single node
#SBATCH --mail-type=BEGIN,END,FAIL           # Email on job start, end, and failure
#SBATCH --error=AMR_Pseudomonas-%A-%a.err    # Error log per array task (%A = job ID, %a = array index)
#SBATCH --job-name=AMR_Pseudomonas           # Job name visible in SLURM queue
#SBATCH --array=1-58%100                     # 58 array jobs, max 100 running simultaneously

echo $SLURM_ARRAY_TASK_ID                    # Print current array task ID for logging

# Define directories and parameters
GENOME_DIR="."                               # Directory containing .fna, .faa, and .gff3 files
OUTDIR="amrfinder_results"                   # Output directory for TSV results
THREADS=4                                    # Number of CPU threads passed to AMRFinderPlus
BATCH_SIZE=100                               # Number of genomes processed per array task

mkdir -p "$OUTDIR"                           # Create output directory if it does not already exist

# Load all .fna files into a sorted array
mapfile -t GENOMES < <(ls "$GENOME_DIR"/*.fna)

# Determine which genomes this array task should process
START=$(( (SLURM_ARRAY_TASK_ID - 1) * BATCH_SIZE ))
END=$(( START + BATCH_SIZE ))

# Loop through assigned genomes in this batch
for (( i=START; i<END && i<${#GENOMES[@]}; i++ )); do
    GENOME="${GENOMES[$i]}"
    BASENAME=$(basename "$GENOME" .fna)       # Strip path and .fna extension for clean naming
    GFF="${GENOME_DIR}/${BASENAME}.gff3"      # Corresponding Bakta GFF3 annotation file
    PROT="${GENOME_DIR}/${BASENAME}.faa"      # Corresponding Bakta protein FASTA file

    amrfinder \
        -p "$PROT" \                          # Protein sequence input
        -n "$GENOME" \                        # Nucleotide sequence input
        -g "$GFF" \                           # GFF3 annotation input (Bakta format)
        -a bakta \                            # Specify annotation format as Bakta
        -o "$OUTDIR/${BASENAME}_amrfinder.tsv" \  # Output TSV named by genome ID
        --threads "$THREADS"                  # Number of threads

done

# QUALITY CHECKS (run manually after job completes)
#   Count number of output TSV files produced:
#       ls -1 amrfinder_results/*.tsv | wc -l
#       (should equal the number of input genomes)
#
#   Check for empty output files (may indicate a failed run):
#       find amrfinder_results/ -name "*.tsv" -empty
#
#   Quick count of total AMR hits across all genomes:
#       cat amrfinder_results/*.tsv | grep -v "^Protein" | wc -l
#
#   Check AMRFinderPlus software and database versions used:
#       amrfinder --version
#       amrfinder --database_version
#
#   Inspect error logs for any failed samples:
#       grep -i "error" AMR_Pseudomonas-*.err

# END OF STAGE 3
```
